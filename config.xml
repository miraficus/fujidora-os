<?xml version="1.0" encoding="utf-8"?>
<image name="fujidora" schemaversion="7.4">
    <description type="system">
        <author>Miraficus</author>
        <contact>vas@email.cz</contact>
        <specification>Fujidora - Herní distribuce s KDE Plasma (Fedora 44)</specification>
    </description>
    
    <preferences>
        <type image="iso" primary="true" flags="overlay" filesystem="squashfs">
            <bootloader name="grub2"/>
        </type>
        <version>1.0.0</version>
        <packagemanager>dnf</packagemanager>
    </preferences>

    <users>
        <user name="liveuser" groups="liveuser,wheel" home="/home/liveuser" shell="/bin/bash" password="live" pwdformat="plain"/>
    </users>

    <!-- PŘÍMÁ ZRCADLA PRO FEDORU 44 -->
    <repository type="rpm-md" alias="fedora">
        <source path="https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/x86_64/os/"/>
    </repository>

    <repository type="rpm-md" alias="fedora-updates">
        <source path="https://dl.fedoraproject.org/pub/fedora/linux/updates/44/Everything/x86_64/"/>
    </repository>

    <!-- COPR REPOZITÁŘE (zůstávají přesně tak, jak fungovaly) -->
    <repository type="rpm-md" alias="copr-cachyos">
        <source path="https://download.copr.fedorainfracloud.org/results/bieszczaders/kernel-cachyos/fedora-44-x86_64/"/>
    </repository>

    <repository type="rpm-md" alias="copr-regreet">
        <source path="https://download.copr.fedorainfracloud.org/results/mystical-devil/ReGreet/fedora-44-x86_64/"/>
    </repository>

    <repository type="rpm-md" alias="rpmfusion-nonfree-steam">
        <source path="https://download1.rpmfusion.org/nonfree/fedora/steam/44/x86_64/"/>
    </repository>

    <repository type="rpm-md" alias="copr-hhd">
    <source path="https://download.copr.fedorainfracloud.org/results/hhd-dev/hhd/fedora-44-x86_64/"/>
    </repository>

    <repository type="rpm-md" alias="vscodium">
    <source path="https://paulcarroty.gitlab.io/vscodium-deb-rpm-repo/rpms/"/>
    </repository>

<!-- ZDE PŘIDEJTE BOOTSTRAP -->
    <packages type="bootstrap">
        <package name="filesystem"/>
        <package name="glibc"/>
        <package name="dnf"/>
        <package name="dnf-plugins-core"/>
        <package name="bash"/>
        <package name="coreutils"/>
        <package name="e2fsprogs"/>
    </packages>

    <!-- BALÍČKY -->
    <packages type="image">
    <!-- NUTNÉ PRO LIVE ISO -->
        <package name="dracut-kiwi-live"/>
        <package name="squashfs-tools"/>
        <package name="dbus-daemon"/>
        <package name="systemd-pam"/>
        <package name="glibc-langpack-cs"/>
        <package name="openssh-server"/>
        <package name="sudo"/>
        <package name="fedora-repos"/>
        <package name="fedora-release-common"/>

        <!-- ZÁKLAD SYSTÉMU (Čisté KDE) -->
        <package name="plasma-desktop"/>
        <package name="plasma-workspace-wayland"/>
        <package name="dolphin"/>
        <package name="kscreen"/>
        <package name="plasma-nm"/>
        <package name="plasma-pa"/>
        <package name="power-profiles-daemon"/>
        <package name="wireplumber"/>
        <package name="pipewire-alsa"/>
        <package name="pipewire-pulseaudio"/>
        <package name="flatpak"/>
        <package name="flatseal"/>
        <package name="sddm"/>
        <package name="sddm-kcm"/>
        <package name="jetbrains-mono-fonts-all"/>
        
        <!-- INSTALÁTOR A DISPLEJ MANAŽER -->
        <package name="calamares"/>
        <package name="kdialog"/>
        <package name="greetd"/>
        <package name="ReGreet"/>
        <package name="cage"/>
        <package name="gamescope"/>
        <package name="greetd-selinux"/>
        
        <!-- JÁDRO CACHYOS -->
        <package name="kernel-cachyos"/>
        <package name="kernel-cachyos-devel-matched"/>
        
        <!-- NATIVNÍ HERNÍ UTILITY A APLIKACE -->
        <package name="steam"/>
        <package name="mangohud"/>
        <package name="gamemode"/>
        <package name="kitty"/>
        <package name="xdg-utils"/>
        <package name="fastfetch"/>
        <package name="vlc"/>
        <package name="conky"/>
        <package name="filezilla"/>
        <package name="openrgb"/>
        <package name="piper"/>
        <package name="gparted"/>
        <package name="htop"/>
        <package name="nano"/>
        <package name="thunderbird"/>
        <package name="qbittorrent"/>
        <package name="lutris"/>
        <package name="codium"/>
        
        <!-- KDE DESKTOP APLIKACE -->
        <package name="plasma-discover"/>
        <package name="plasma-discover-packagekit"/>
        <package name="plasma-discover-flatpak"/>
        <package name="kvantum"/>
        <package name="aurorae"/>
        <package name="curl-minimal"/>
        <package name="gwenview"/>
        <package name="okular"/>
        <package name="ark"/>
        <package name="spectacle"/>
        <package name="kamoso"/>
        <package name="kcalc"/>
        <package name="kde-connect"/>
        <package name="kolourpaint"/>

        <!-- Podpora souborových systémů pro USB disky a formátování -->
        <package name="btrfs-progs"/>
        <package name="dosfstools"/>
        <package name="exfatprogs"/>
        <package name="ntfs-3g"/>
        <package name="e2fsprogs"/>
        <package name="xfsprogs"/>
        <package name="kpartx"/>
    </packages>
</image>
